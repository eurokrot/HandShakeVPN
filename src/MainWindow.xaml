<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HandShake VPN"
 Width="380" Height="650" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 FontFamily="Segoe UI" Foreground="White" UseLayoutRounding="True">
<Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2864EB"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#193867"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7184A2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
 <Border x:Name="MainSurface" CornerRadius="26" BorderBrush="#55FFFFFF" BorderThickness="1">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#258FE3"/><GradientStop Color="#2156B4" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid x:Name="AppRoot">
   <Canvas x:Name="WaveLayer" ClipToBounds="True" IsHitTestVisible="False" Opacity="0.90">
    <Path x:Name="Wave1" Canvas.Left="-120" Canvas.Top="42" Fill="#1BFFFFFF" Data="M 0,100 C 85,22 185,22 270,100 C 355,178 455,178 540,100 L 540,250 L 0,250 Z" Width="540" Height="250" Stretch="Fill"/>
    <Path x:Name="Wave2" Canvas.Left="-70" Canvas.Top="238" Fill="#167FDDFF" Data="M 0,82 C 70,20 155,18 230,82 C 305,146 390,148 470,82 L 470,245 L 0,245 Z" Width="470" Height="245" Stretch="Fill"/>
    <Path x:Name="Wave3" Canvas.Left="-180" Canvas.Top="132" Fill="#0F86CFFF" Data="M 0,66 C 92,5 190,8 285,70 C 380,132 485,128 590,56 L 590,210 L 0,210 Z" Width="590" Height="210" Stretch="Fill"/>
    <Ellipse x:Name="WaveGlow" Canvas.Left="-90" Canvas.Top="420" Width="430" Height="260" Fill="#11FFFFFF"/>
   </Canvas>
   <Grid x:Name="HomeContent" Margin="24,12,24,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="Transparent" Margin="-6,0,-6,0">
     <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="58"/></Grid.RowDefinitions>
     <TextBlock x:Name="PreviewLabel" Text="VPN / PREVIEW" FontSize="9" Foreground="#CFE8FF" VerticalAlignment="Center" Margin="7,0,0,0"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="PinWindow" Content="📌" FontFamily="Segoe UI Emoji" AutomationProperties.Name="Закрепить поверх окон" ToolTip="Закрепить поверх окон" Background="Transparent" Foreground="White" Padding="8,0" FontSize="12"/>
      <Button x:Name="MinimizeWindow" Content="−" AutomationProperties.Name="Свернуть окно" Background="Transparent" Foreground="White" Padding="10,0" FontSize="17"/>
      <Button x:Name="CloseWindow" Content="×" AutomationProperties.Name="Свернуть в трей" Background="Transparent" Foreground="White" Padding="10,0" FontSize="18"/>
     </StackPanel>
     <Button x:Name="MenuButton" Grid.Row="1" Width="38" Height="38" HorizontalAlignment="Left" Background="#20FFFFFF" Padding="10" AutomationProperties.Name="Открыть меню">
      <StackPanel><Border Height="2" Width="17" Background="White" CornerRadius="1"/><Border Height="2" Width="17" Background="White" CornerRadius="1" Margin="0,4"/><Border Height="2" Width="17" Background="White" CornerRadius="1"/></StackPanel>
     </Button>
     <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <StackPanel VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="HandShake" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="BrandSubtitle" Text="COMMUNITY NETWORK" FontSize="8" HorizontalAlignment="Right" Foreground="#D5ECFF" Margin="0,3,0,0"/></StackPanel>
      <Border x:Name="LogoPlaceholder" Width="38" Height="38" Background="#25FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="12" ToolTip="Логотип HandShake" Padding="4">
       <Image x:Name="BrandLogo" Width="28" Height="28" Stretch="Uniform" SnapsToDevicePixels="True"/>
      </Border>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
     <Button x:Name="CircleConnect" Width="174" Height="174" HorizontalAlignment="Center" Margin="0,8,0,20" AutomationProperties.Name="Подключиться к VPN">
      <Button.Template><ControlTemplate TargetType="Button">
       <Grid x:Name="StatusCircle" Width="174" Height="174">
        <Ellipse Stroke="#45FFFFFF" StrokeThickness="1"/>
        <Ellipse x:Name="CircleFill" Fill="#F5F9FF" Margin="9"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Grid>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CircleFill" Property="Fill" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CircleFill" Property="Fill" Value="#E1F0FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CircleFill" Property="Stroke" Value="#82CFFF"/><Setter TargetName="CircleFill" Property="StrokeThickness" Value="3"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Button.Template>
      <Grid Width="166" Height="166">
       <Ellipse x:Name="SuccessFill" Margin="3" Fill="#55DA91" Opacity="0"/>
       <Ellipse x:Name="ConnectionRing" Margin="3" Stroke="#92DCFF" StrokeThickness="2" StrokeDashArray="6 4" Visibility="Collapsed" RenderTransformOrigin=".5,.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
       <TextBlock x:Name="Face" FontFamily="Consolas, Segoe UI Symbol" FontSize="22" Foreground="#8092AA" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock>
      </Grid>
     </Button>
     <TextBlock x:Name="StateTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
     <TextBlock x:Name="StateDescription" FontSize="11" Foreground="#DEEEFF" TextAlignment="Center" Margin="0,8,0,18"/>
     <Button x:Name="ConnectButton" Content="Подключиться" Background="#F7FAFF" Foreground="#215EB4" FontWeight="SemiBold" FontSize="14" Padding="16,14"/>
     <TextBlock x:Name="SessionInfo" FontSize="10" TextAlignment="Center" Foreground="#D9EFFF" Margin="0,12,0,12"/>
    </StackPanel>
    <Border Grid.Row="2" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14,13" Margin="0,0,0,20">
     <StackPanel>
      <TextBlock x:Name="BestNodeLabel" Text="САМЫЙ БЫСТРЫЙ УЗЕЛ" FontSize="9" Foreground="#D9EFFF"/>
      <ComboBox x:Name="HomeLocationPicker" Padding="7" FontSize="11" Margin="0,7,0,0" Foreground="#183D66">
       <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding FlagImage}" Width="20" Height="14" Margin="0,0,7,0"/><TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="BestLocation" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="BestSpeed" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SpeedUnit" Text=" ms" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel>
      </Grid>
      <TextBlock x:Name="BestMeta" FontSize="9" Foreground="#CBE5FF" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>
    <StackPanel Grid.Row="3">
     <TextBlock x:Name="NodeServiceStatus" Text="○  Node Service · не установлена" TextAlignment="Center" FontSize="10" Foreground="#D9EFFF"/>
     <TextBlock x:Name="PreviewWarning" Text="Предпросмотр · VPN не защищает трафик" TextAlignment="Center" FontSize="9" Foreground="#CBE5FF" Margin="0,6,0,0"/>
    </StackPanel>
   </Grid>
    <Grid x:Name="MenuOverlay" Visibility="Collapsed">
     <Border x:Name="MenuBackdrop" Background="#40091A38" CornerRadius="26" Opacity="0"/>
     <Border x:Name="MenuPanel" Background="#F6F9FF" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top" Width="270" Margin="16,83,0,0" Padding="14" TextElement.Foreground="#19345C" Opacity="0">
      <Border.RenderTransform><TranslateTransform X="-300"/></Border.RenderTransform>
     <StackPanel>
      <Grid Margin="6,0,0,12"><TextBlock x:Name="MenuTitle" Text="Меню" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseMenu" Content="×" HorizontalAlignment="Right" Padding="9,3" Background="Transparent" AutomationProperties.Name="Закрыть меню"/></Grid>
      <Button x:Name="NavMap" Content="◎   Карта сети" Background="#E8F1FF" Margin="0,0,0,8"/>
      <Button x:Name="NavSettings" Content="⚙   Оформление" Background="#E8F1FF"/>
      <Button x:Name="NavActivation" Content="⌁   Активация" Background="#E8F1FF" Margin="0,8,0,0"/>
      <Button x:Name="RestoreNetwork" Content="Восстановить обычную сеть" Background="#E8F1FF" Margin="0,8,0,0"/>
      <Button x:Name="LanguageButton" Content="EN   English" Background="#E8F1FF" Margin="0,8,0,0"/>
      <TextBlock x:Name="MenuNodeStatus" Text="Node Service · не установлена" Foreground="#7184A2" FontSize="11" Margin="8,18,0,8"/>
      <Button x:Name="MenuHide" Content="Свернуть в трей" Background="Transparent" FontSize="12"/>
     </StackPanel>
    </Border>
   </Grid>
   <Grid x:Name="SettingsOverlay" Visibility="Collapsed">
    <Border x:Name="SettingsBackdrop" Background="#60071938" CornerRadius="26"/>
    <Border Background="#F6F9FF" CornerRadius="22" Margin="14,85,14,18" Padding="20" TextElement.Foreground="#19345C">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,14"><TextBlock x:Name="SettingsTitle" Text="Оформление" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseSettings" Content="×" HorizontalAlignment="Right" Padding="10,3" Background="#E5EEFC" AutomationProperties.Name="Закрыть оформление"/></Grid>
      <Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    
                    <TextBlock x:Name="SettingsIntro" Text="Оформление сохраняется на этом устройстве." Foreground="#7184A2" Margin="0,0,0,18"/>
                    <TextBlock x:Name="AccentLabel" Text="Основной цвет" FontWeight="SemiBold"/>
                    <WrapPanel x:Name="AccentOptions" Margin="0,12,0,22"/>
                    <TextBlock x:Name="CustomColorLabel" Text="Свой цвет (например, #2864EB)" Foreground="#7184A2" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,20"><TextBox x:Name="CustomAccent" Width="115" Padding="10" Text="#2864EB"/><Button x:Name="ApplyAccent" Content="Применить" Padding="12,10" FontSize="12" Background="#EDF3FF" Margin="10,0,0,0"/></StackPanel>
                    <TextBlock x:Name="BackgroundLabel" Text="Оттенок фона" FontWeight="SemiBold"/><ComboBox x:Name="BackgroundPicker" Width="260" HorizontalAlignment="Left" Margin="0,8,0,15" Padding="8"/>
                    <TextBlock x:Name="FontLabel" Text="Шрифт интерфейса" FontWeight="SemiBold"/><ComboBox x:Name="FontPicker" Width="260" HorizontalAlignment="Left" Margin="0,8,0,15" Padding="8"/>
                    <TextBlock x:Name="ScenarioLabel" Text="Проверка сценариев" FontWeight="SemiBold"/><CheckBox x:Name="SimulateError" Content="Сымитировать ошибку подключения" Margin="0,12,0,16"/>
                    <StackPanel x:Name="NodeParticipationPanel" Visibility="Collapsed" Margin="0,0,0,16">
                     <TextBlock x:Name="NodeParticipationLabel" Text="Участие выходного узла" FontWeight="SemiBold"/>
                     <CheckBox x:Name="NodeParticipationToggle" Content="Предоставлять выход через мой IP" Margin="0,10,0,0"/>
                     <TextBlock x:Name="NodeParticipationStatus" Foreground="#7184A2" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="ResetSettings" Content="Сбросить оформление" HorizontalAlignment="Left" Background="#EDF3FF"/>
                    <TextBlock x:Name="SettingsStatus" Foreground="#7184A2" FontSize="12" Margin="0,14,0,0"/>
                </StackPanel></ScrollViewer></Grid>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="ActivationOverlay" Panel.ZIndex="50" Background="#B5091A38">
    <Border Background="#F8FAFF" CornerRadius="24" Margin="14,62,14,18" Padding="22" TextElement.Foreground="#19345C">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
       <Border x:Name="ActivationModeBadge" Background="#E4EEFF" CornerRadius="8" HorizontalAlignment="Left" Padding="9,5"><TextBlock x:Name="ActivationModeText" Text="АКТИВАЦИЯ" FontSize="9" FontWeight="Bold"/></Border>
       <Button x:Name="CloseActivation" Content="×" HorizontalAlignment="Right" Padding="9,3" Background="#E5EEFC" Visibility="Collapsed" AutomationProperties.Name="Закрыть активацию"/>
      </Grid>
      <StackPanel Grid.Row="1" VerticalAlignment="Center">
       <TextBlock x:Name="ActivationTitle" Text="Активируйте HandShake" FontSize="22" FontWeight="SemiBold"/>
       <TextBlock x:Name="ActivationDescription" Text="Введите месячный ключ, полученный на сайте. Регистрация не нужна." Foreground="#607493" FontSize="12" Margin="0,9,0,22"/>
       <TextBlock x:Name="ActivationKeyLabel" Text="Ключ активации" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <TextBox x:Name="ActivationKey" MaxLength="160" Padding="12,11" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Center"/>
       <Button x:Name="ActivateButton" Content="Активировать" Background="#2864EB" Foreground="White" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <Button x:Name="ContinueDemo" Content="Открыть предпросмотр" Background="#E7EFFC" Margin="0,9,0,0" Visibility="Collapsed"/>
       <Button x:Name="ActivationRestoreNetwork" Content="Восстановить обычную сеть" Background="#E7EFFC" Margin="0,9,0,0"/>
       <TextBlock x:Name="ActivationStatus" Foreground="#B33A4A" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Row="2">
       <TextBlock x:Name="IdentityStatus" Text="Идентификатор устройства создаётся без сохранения серийного номера." Foreground="#7184A2" FontSize="9" TextWrapping="Wrap"/>
       <TextBlock x:Name="TransportStatus" Text="Сетевой транспорт пока не установлен; активация сама по себе не включает VPN." Foreground="#7184A2" FontSize="9" Margin="0,7,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>
