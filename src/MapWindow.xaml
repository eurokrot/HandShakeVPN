<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HandShake · Карта сети" Width="1000" Height="670" MinWidth="730" MinHeight="520" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanMinimize" Background="Transparent" Foreground="White" FontFamily="Segoe UI">
<Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2864EB"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#193867"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7184A2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
<Border Background="#050609" CornerRadius="22" BorderBrush="#34425A" BorderThickness="1"><Grid Margin="20">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid x:Name="MapTitleBar" Background="Transparent" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="MapTitle" Text="Карта сети" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="MapLegend" Text="● Доступные узлы     • Ваша позиция — оранжевая (демо)" FontSize="11" Foreground="#8B9BBC" Margin="0,6,0,0"/></StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
   <Button x:Name="ZoomOut" Content="−" Padding="12,6" Background="#17243E" Foreground="White"/>
   <Button x:Name="ZoomReset" Content="Мир" Padding="12,6" Margin="6,0" Background="#17243E" Foreground="White"/>
   <Button x:Name="ZoomIn" Content="+" Padding="12,6" Background="#17243E" Foreground="White"/>
   <Button x:Name="MapClose" Content="×" AutomationProperties.Name="Закрыть карту" Padding="12,6" Margin="14,0,0,0" Background="#17243E" Foreground="White"/>
  </StackPanel>
 </Grid>
 <ScrollViewer x:Name="MapScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Black" CanContentScroll="False">
  <Viewbox x:Name="MapView" Width="920" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas x:Name="WorldMap" Width="1200" Height="540" ClipToBounds="True" Background="Black"/></Viewbox>
 </ScrollViewer>
 <Border Grid.Row="2" Background="#101A2D" CornerRadius="10" Padding="16" Margin="0,12,0,0">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <ComboBox x:Name="LocationPicker" Width="350" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,7">
     <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding FlagImage}" Width="20" Height="14" Margin="0,0,7,0"/><TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock x:Name="MapLocation" FontSize="14" FontWeight="SemiBold"/>
    <TextBlock x:Name="MapDetails" Foreground="#9AABCC" FontSize="11" Margin="0,6,0,0"/>
    <TextBlock x:Name="MapSource" Text="Natural Earth · IP Geolocation by DB-IP · db-ip.com" Foreground="#607493" FontSize="9" Margin="0,8,0,0"/>
   </StackPanel>
   <Button x:Name="MapConnect" Grid.Column="1" Content="Подключиться" Background="#2189EE" Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
  </Grid>
 </Border>
</Grid></Border>
</Window>
